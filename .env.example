# Copiar a .env y llenar. El archivo .env NUNCA se commitea (bloqueado en .gitignore).

# Postgres (Supabase → Connect → connection string URI, pooler session mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Proyecto Supabase (Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # solo backend/tools; jamás en un front

# Origen de datos para el sync F1 (carpeta con los GAP_DATA_*.xlsx)
GAP_DATA_SRC=C:/Users/david/Downloads/administrativo

# Protección interina del front en despliegue (F1; en F2 la reemplaza OIDC Google)
# Sin estas dos variables el middleware no exige nada (útil en local).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Digest diario por correo (tools/digest.py). Con Google Workspace: host de Gmail,
# puerto 587, usuario = la cuenta remitente y, como clave, una contraseña de
# aplicación (nunca la de la cuenta). Ver README «Digest diario».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO=
