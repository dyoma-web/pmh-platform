# Copiar a .env y llenar. El archivo .env NUNCA se commitea (bloqueado en .gitignore).

# Postgres (Supabase → Project Settings → Database → Connection string, URI, pooler session mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Proyecto Supabase (Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # solo backend/tools; jamás en un front

# Origen de datos para el sync F1 (carpeta con los GAP_DATA_*.xlsx)
GAP_DATA_SRC=C:/Users/david/Downloads/administrativo
